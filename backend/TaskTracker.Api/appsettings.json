{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Limits": {
    "MaxTasksPerClient": 200
  },
  "RateLimiting": {
    "PerIpPerMinute": 120,
    "PerIpWritesPerMinute": 30,
    "GlobalPerMinute": 600,
    "GlobalCreatesPerHour": 600
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
